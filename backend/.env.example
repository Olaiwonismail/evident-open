# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/evident

# App
APP_BASE_URL=https://your-public-url.example.com
# NOTE: this is also key material — smart-wallet owner keys are derived from it.
# Rotating it orphans every provisioned wallet. Back it up like a private key.
SECRET_KEY=generate-a-random-secret-key-here

# BMoni
BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=your_sandbox_api_key
# sandbox-only BVN; real ones are rejected outside production
BMONI_TEST_BVN=22222222222
# from POST /v1/webhooks/config — set to enable signature verification
BMONI_WEBHOOK_SECRET=
